    "terminal.ansiBrightRed": "#F07F8D",
    "terminal.ansiGreen": "#C3D4F2",
    "terminal.ansiBrightGreen": "#DDE7F8",
    "terminal.ansiYellow": "#F2A3AD",
    "terminal.ansiBrightYellow": "#F7C4CA",
    "terminal.ansiBlue": "#7da6e8",
    "terminal.ansiBrightBlue": "#a4c1ef",
    "terminal.ansiMagenta": "#C9A3D9",
    "terminal.ansiBrightMagenta": "#DCC2E6",
    "terminal.ansiCyan": "#a9c8f5",
    "terminal.ansiBrightCyan": "#c3d9f8",
    "terminal.ansiWhite": "#d5d4d1",
    "terminal.ansiBrightWhite": "#e8e3dc"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8d8ca6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword, storage and operator",
      "scope": [
        "keyword",
        "storage",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#7da6e8"
      }
    },
    {
      "name": "Control flow and module keywords (import, export, return, if)",
      "scope": [
        "keyword.control",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": {
        "foreground": "#EB5A6C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Language constant (true, false, null, undefined)",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#F0C76C"
      }
    },
    {
      "name": "Template expression ${}",
      "scope": [
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#7da6e8"
      }
    },
    {
      "name": "HTML and JSX tag",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#7da6e8"
      }
    },
    {
      "name": "Function and method",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#c3d4f2"
      }
    },
    {
      "name": "Property key (JSON, object literal, CSS)",
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#c3d4f2"
      }
    },
    {
      "name": "JSX and HTML attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#c3d4f2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#f2a3ad"
      }
    },
    {
      "name": "Type, class and interface",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#F0C76C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#F0C76C"
      }
    },
    {
      "name": "Rare accents: this, regex, escapes",
      "scope": [
        "variable.language",
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#eb5a6c",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#c3d4f2",
    "method": "#c3d4f2",
    "class": {
      "foreground": "#F0C76C",
      "italic": true
    },
    "type": {
      "foreground": "#F0C76C",
      "italic": true
    },
    "interface": {
      "foreground": "#F0C76C",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#F0C76C",
      "italic": true
    },
    "enum": {
      "foreground": "#F0C76C",
      "italic": true
    },
    "enumMember": {
      "foreground": "#eb5a6c",
      "italic": true
    },
    "property.declaration": "#e8e3dc",
    "parameter": {
      "italic": true
    },
    "property": "#e8e3dc"
  }
}
