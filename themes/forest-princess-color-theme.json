    "gitDecoration.stageModifiedResourceForeground": "#a9c8f5",
    "gitDecoration.untrackedResourceForeground": "#c3d4f2",
    "gitDecoration.addedResourceForeground": "#c3d4f2",
    "gitDecoration.renamedResourceForeground": "#c3d4f2",
    "gitDecoration.deletedResourceForeground": "#f08a9a",
    "gitDecoration.stageDeletedResourceForeground": "#f08a9a",
    "gitDecoration.conflictingResourceForeground": "#f08a9a",
