    "panelTitle.activeForeground": "#e8e3dc",
    "panelTitle.inactiveForeground": "#70839a",
    "panelTitle.activeBorder": "#EB5A6C",
    "terminal.foreground": "#e8e3dc",
    "activityBarTop.foreground": "#7DA6E8",
