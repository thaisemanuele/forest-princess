    "modernTab.activeForeground": "#e8e3dc",
    "modernTab.hoverBackground": "#16283f",
    "modernTab.hoverForeground": "#e8e3dc",
    "modernPanel.border": "#16283f",
    "modernUI.shellBackground": "#0b121c",
    "terminalCursor.foreground": "#E8E3DC",
    "terminal.selectionBackground": "#315b9199",
    "terminal.findMatchBackground": "#7da6e855",
