    "sideBarSectionHeader.background": "#0b121c",
    "sideBarSectionHeader.foreground": "#9fa8b4",
    "sideBarSectionHeader.border": "#16283f",
    "list.activeSelectionForeground": "#e8e3dc",
    "list.inactiveSelectionBackground": "#16283f",
    "list.inactiveSelectionForeground": "#d5d4d1",
    "list.hoverForeground": "#e8e3dc",
    "tree.indentGuidesStroke": "#294c7a",
    "activityBar.inactiveForeground": "#9DB3D6",
    "tab.activeForeground": "#e8e3dc",
    "tab.inactiveForeground": "#70839a",
    "tab.border": "#0b121c",
